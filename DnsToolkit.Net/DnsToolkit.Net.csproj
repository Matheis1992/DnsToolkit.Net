<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <BaseOutputPath>..\bin</BaseOutputPath>
    <BaseIntermediateOutputPath></BaseIntermediateOutputPath>
    <Nullable>enable</Nullable>
    <!-- the analyzers only run for .NET 5 or later by default, the code for netstandard2.0 is checked as well -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Title>DnsToolkit.Net - C#/.Net DNS client/server, DNSSEC, DANE and SPF Library</Title>
    <Authors>Alexander Reinert, Matheis1992</Authors>
    <Description>A complete managed .Net DNS and DNSSEC client, a DNS server (UDP, TCP, TLS, HTTPS), DANE validation and SPF and SenderID validation. Targets netstandard2.0, net8.0 and net10.0. Based on ARSoft.Tools.Net by Alexander Reinert.</Description>
    <PackageProjectUrl>https://github.com/Matheis1992/DnsToolkit.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Matheis1992/DnsToolkit.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dns dnssec dane spf doh dot dns-over-https dns-over-tls</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Copyright>Copyright 2010..2024 Alexander Reinert, 2026 Matheis1992</Copyright>
    <!-- a new package, so it starts at 1.0.0 instead of continuing the versions of ARSoft.Tools.Net; the suffix is removed for the release -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- part of the ASP.NET Core shared framework on net8.0+ -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.2" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.2" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.2" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- The DNS over HTTPS server requires ASP.NET Core and is only available on net8.0+ -->
    <Compile Remove="Dns\EndpointRouteBuilderExtensions.cs" />
    <Compile Remove="Dns\Transport\HttpsServerTransport.cs" />
    <Compile Remove="Dns\Transport\HttpsServerTransportOptions.cs" />
  </ItemGroup>

  <!-- In the root of the package. As content files, NuGet copied them into the projects and the output of every user of the package. -->
  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\NOTICE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DnsToolkit.Net.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;1591</NoWarn>
    <!-- The netstandard2.0 BCL is not annotated for nullable reference types, which results in false positives -->
    <NoWarn Condition="'$(TargetFramework)' == 'netstandard2.0'">$(NoWarn);nullable</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>